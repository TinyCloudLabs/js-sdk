{
  "name": "@tinycloud/node-sdk",
  "version": "3.1.0",
  "description": "TinyCloud SDK for Node.js with configurable authorization strategies",
  "author": "TinyCloud, Inc.",
  "license": "EGPL",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./replication/runtime": {
      "import": {
        "types": "./dist/replication/runtime.d.ts",
        "default": "./dist/replication/runtime.js"
      },
      "require": {
        "types": "./dist/replication/runtime.d.cts",
        "default": "./dist/replication/runtime.cjs"
      }
    },
    "./replication/authority": {
      "import": {
        "types": "./dist/replication/authority.d.ts",
        "default": "./dist/replication/authority.js"
      },
      "require": {
        "types": "./dist/replication/authority.d.cts",
        "default": "./dist/replication/authority.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "bun test src/",
    "typecheck:replica-contract": "tsc --noEmit -p tsconfig.replica-contract.json",
    "test:integration": "echo 'Integration tests live in tests/node-sdk workspace'"
  },
  "dependencies": {
    "@tinycloud/replica": "0.1.0",
    "@tinycloud/sdk-services": "3.1.0",
    "@tinycloud/sdk-core": "3.1.0",
    "@tinycloud/node-sdk-wasm": "1.7.7",
    "siwe": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tinycloudlabs/web-sdk"
  }
}

{
  "name": "@tinycloud/node-sdk",
  "version": "3.9.0-beta.3",
  "description": "TinyCloud SDK for Node.js with configurable authorization strategies",
  "author": "TinyCloud, Inc.",
  "license": "EGPL",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./encryption-keys": {
      "import": {
        "types": "./dist/encryption-keys.d.ts",
        "default": "./dist/encryption-keys.js"
      },
      "require": {
        "types": "./dist/encryption-keys.d.cts",
        "default": "./dist/encryption-keys.cjs"
      }
    },
    "./credential-pending-store": {
      "types": "./dist/credential-pending-store.d.ts",
      "import": "./dist/credential-pending-store.js",
      "require": "./dist/credential-pending-store.cjs"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js",
      "require": "./dist/credentials.cjs"
    },
    "./credentials-core": {
      "types": "./dist/credentials-core.d.ts",
      "import": "./dist/credentials-core.js",
      "require": "./dist/credentials-core.cjs"
    },
    "./share-receive": {
      "types": "./dist/share-receive.d.ts",
      "import": "./dist/share-receive.js",
      "require": "./dist/share-receive.cjs"
    },
    "./replication/runtime": {
      "import": {
        "types": "./dist/replication/runtime.d.ts",
        "default": "./dist/replication/runtime.js"
      },
      "require": {
        "types": "./dist/replication/runtime.d.cts",
        "default": "./dist/replication/runtime.cjs"
      }
    },
    "./replication/authority": {
      "import": {
        "types": "./dist/replication/authority.d.ts",
        "default": "./dist/replication/authority.js"
      },
      "require": {
        "types": "./dist/replication/authority.d.cts",
        "default": "./dist/replication/authority.cjs"
      }
    },
    "./replication/gated-network": {
      "import": {
        "types": "./dist/replication/gated-network.d.ts",
        "default": "./dist/replication/gated-network.js"
      },
      "require": {
        "types": "./dist/replication/gated-network.d.cts",
        "default": "./dist/replication/gated-network.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "bun test src/",
    "typecheck:replica-contract": "tsc --noEmit -p tsconfig.replica-contract.json",
    "test:integration": "echo 'Integration tests live in tests/node-sdk workspace'"
  },
  "dependencies": {
    "@tinycloud/share-sdk": "1.4.2-beta.1",
    "@tinycloud/share-envelope": "1.4.1-beta.0",
    "@tinycloud/replica": "0.4.0",
    "@tinycloud/sdk-services": "3.8.0",
    "@tinycloud/sdk-core": "3.9.0-beta.3",
    "@tinycloud/node-sdk-wasm": "1.7.8",
    "siwe": "^3.0.0"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.7",
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tinycloudlabs/web-sdk"
  }
}

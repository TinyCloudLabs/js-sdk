{
  "name": "@tinycloud/operations",
  "version": "0.7.8-beta.5",
  "description": "TinyCloud shared operations contracts and runtime",
  "author": "TinyCloud, Inc.",
  "license": "EGPL",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "import": "./dist/artifacts.js",
      "require": "./dist/artifacts.cjs"
    },
    "./cli-runtime": {
      "types": "./dist/cli-runtime.d.ts",
      "import": "./dist/cli-runtime.js",
      "require": "./dist/cli-runtime.cjs"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js",
      "require": "./dist/profile.cjs"
    },
    "./delegation-binding": {
      "types": "./dist/delegation-binding.d.ts",
      "import": "./dist/delegation-binding.js",
      "require": "./dist/delegation-binding.cjs"
    },
    "./secret-capabilities": {
      "types": "./dist/secret-capabilities.d.ts",
      "import": "./dist/secret-capabilities.js",
      "require": "./dist/secret-capabilities.cjs"
    },
    "./secret-request": {
      "types": "./dist/secret-request.d.ts",
      "import": "./dist/secret-request.js",
      "require": "./dist/secret-request.cjs"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js",
      "require": "./dist/recovery.cjs"
    },
    "./revoked-grant": {
      "types": "./dist/revoked-grant.d.ts",
      "import": "./dist/revoked-grant.js",
      "require": "./dist/revoked-grant.cjs"
    },
    "./cli-name": {
      "types": "./dist/cli-name.d.ts",
      "import": "./dist/cli-name.js",
      "require": "./dist/cli-name.cjs"
    },
    "./tc-apps": {
      "types": "./dist/tc-apps.d.ts",
      "import": "./dist/tc-apps.js",
      "require": "./dist/tc-apps.cjs"
    },
    "./mcp-authority": {
      "types": "./dist/mcp-authority.d.ts",
      "import": "./dist/mcp-authority.js",
      "require": "./dist/mcp-authority.cjs"
    },
    "./operations.json": "./generated/operations.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "generated/operations.json",
    "coverage.json"
  ],
  "scripts": {
    "build": "tsup --entry src/index.ts --entry src/state.ts --entry src/artifacts.ts --entry src/cli-runtime.ts --entry src/profile.ts --entry src/secret-capabilities.ts --entry src/delegation-binding.ts --entry src/secret-request.ts --entry src/recovery.ts --entry src/cli-name.ts --entry src/revoked-grant.ts --entry src/tc-apps.ts --entry src/mcp-authority.ts",
    "clean": "rm -rf dist",
    "test": "bun scripts/test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check:typecheck-inputs": "tsc --listFilesOnly -p tsconfig.typecheck.json | grep -F 'packages/operations/src/contract.test.ts' && tsc --listFilesOnly -p tsconfig.typecheck.json | grep -F 'packages/operations/test-support/append-profile-record.ts' && tsc --listFilesOnly -p tsconfig.typecheck.json | grep -F 'packages/operations/test-support/hold-profile-store-writer.ts' && tsc --listFilesOnly -p tsconfig.typecheck.json | grep -F 'packages/operations/scripts/generate.ts' && tsc --listFilesOnly -p tsconfig.typecheck.json | grep -F 'packages/operations/tsup.config.ts'",
    "generate": "bun scripts/generate.ts",
    "check:generated": "bun scripts/generate.ts --check"
  },
  "dependencies": {
    "@tinycloud/node-sdk": "3.9.0-beta.5",
    "@tinycloud/sdk-core": "3.9.0-beta.5",
    "@tinycloud/sdk-services": "3.8.0",
    "node-sql-parser": "5.4.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tinycloudlabs/web-sdk"
  }
}

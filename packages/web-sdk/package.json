{
  "name": "@tinycloud/web-sdk",
  "version": "3.9.0-beta.3",
  "description": "A set of tools and utilities to help you build your app with TinyCloud.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./replica": {
      "types": "./dist/replica.d.ts",
      "import": "./dist/replica.mjs",
      "require": "./dist/replica.cjs"
    },
    "./replica-gated": {
      "types": "./dist/replica-gated.d.ts",
      "import": "./dist/replica-gated.mjs",
      "require": "./dist/replica-gated.cjs"
    },
    "./credentials": {
      "types": "./dist/credentials-subpath.d.ts",
      "import": "./dist/credentials.mjs",
      "require": "./dist/credentials.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:TinyCloudLabs/web-sdk.git"
  },
  "type": "module",
  "author": "TinyCloud, Inc.",
  "license": "EGPL",
  "sideEffects": [
    "dist/index.cjs",
    "dist/index.mjs"
  ],
  "scripts": {
    "build": "rimraf dist && cross-env NODE_ENV=production webpack --mode production --config webpack.config.cjs",
    "build:coordinationos-vendor": "rimraf dist/vendor && cross-env NODE_ENV=production webpack --mode production --config webpack.coordinationos-vendor.config.cjs && bun scripts/build-coordinationos-vendor.ts",
    "dev": "cross-env NODE_ENV=development webpack --watch --config webpack.config.cjs",
    "watch": "cross-env NODE_ENV=development webpack --watch --config webpack.config.cjs",
    "doc": "bun run doc:extractor && bun run doc:documenter",
    "doc:extractor": "api-extractor run --local --diagnostics",
    "doc:documenter": "api-documenter markdown -i temp -o ../../documentation/docs/web-sdk/api",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix",
    "clean": "rimraf dist && rimraf temp",
    "build:e2e-ui": "bun build ./e2e/fixtures/harness-entry.ts --target=browser --format=esm --splitting --outdir=./e2e/.build/ui",
    "build:e2e-storage": "bun build ./e2e/fixtures/storage-harness-entry.ts --target=browser --format=iife --outfile=./e2e/.build/storage.bundle.js",
    "build:e2e-prompts": "bun build ./e2e/fixtures/prompts-harness-entry.ts --target=browser --format=iife --outfile=./e2e/.build/prompts.bundle.js",
    "build:e2e-data-proxy": "bun build ./e2e/fixtures/data-proxy-harness-entry.ts --target=browser --format=esm --splitting --outdir=./e2e/.build/data-proxy",
    "build:e2e-prompts-lazy": "bun build ./e2e/fixtures/prompts-lazy-harness-entry.ts --target=browser --format=esm --splitting --outdir=./e2e/.build/prompts-lazy",
    "build:e2e-prefetch": "bun build ./e2e/fixtures/prefetch-harness-entry.ts --target=browser --format=esm --splitting --outdir=./e2e/.build/prefetch",
    "test:e2e": "bun run build:e2e-ui && bun run build:e2e-storage && bun run build:e2e-prompts && bun run build:e2e-prompts-lazy && bun run build:e2e-prefetch && bun run build:e2e-data-proxy && playwright test -c playwright.e2e.config.ts",
    "test": "jest"
  },
  "dependencies": {
    "@multiformats/multiaddr": "^13.0.1",
    "@multiformats/multiaddr-to-uri": "^12.0.0",
    "@noble/curves": "^1.9.7",
    "@tinycloud/node-sdk": "3.9.0-beta.3",
    "@tinycloud/replica": "0.4.0",
    "@tinycloud/sdk-core": "3.9.0-beta.3",
    "@tinycloud/share-envelope": "1.4.1-beta.0",
    "@tinycloud/share-sdk": "1.4.2-beta.1",
    "@tinycloud/web-sdk-wasm": "1.7.7",
    "axios": "^1.7.9",
    "viem": "^2.45.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.7",
    "@microsoft/api-documenter": "^7.26.5",
    "@microsoft/api-extractor": "^7.49.1",
    "@playwright/test": "1.58.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.19.74",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.58.0",
    "@webpack-cli/generators": "^3.0.7",
    "assert": "^2.1.0",
    "babel-jest": "^30.3.0",
    "browser": "^0.2.6",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "10.1.0",
    "crypto-browserify": "^3.12.1",
    "declaration-bundler-webpack-plugin": "^1.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "events": "^3.3.0",
    "gh-pages": "^6.3.0",
    "https-browserify": "^1.0.0",
    "jsdom": "26.1.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^7.0.0"
  },
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.LICENSE.txt"
  ]
}

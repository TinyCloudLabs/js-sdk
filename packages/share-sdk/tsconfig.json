{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/index.ts", "src/receive.ts", "src/publish.ts", "src/addressed.ts", "src/cache.ts", "src/owner-policy.ts", "src/delivery.ts", "src/history.ts"]
}

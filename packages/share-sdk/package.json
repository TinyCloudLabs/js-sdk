{
  "name": "@tinycloud/share-sdk",
  "version": "1.2.0-beta.0",
  "description": "Canonical headless TinyCloud Share operations for browser and Node.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./artifact": {
      "types": "./dist/artifact.d.ts",
      "import": "./dist/artifact.js",
      "require": "./dist/artifact.cjs",
      "default": "./dist/artifact.js"
    },
    "./share-index": {
      "types": "./dist/share-index.d.ts",
      "import": "./dist/share-index.js",
      "require": "./dist/share-index.cjs",
      "default": "./dist/share-index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "^1.8.0",
    "@tinycloud/share-envelope": "1.1.0",
    "multiformats": "^13.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

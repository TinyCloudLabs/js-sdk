{
  "name": "@tinycloud/courier",
  "version": "0.4.1-beta.6",
  "description": "Courier: agent-to-agent threads over TinyCloud (CLI, library and agent skill)",
  "author": "TinyCloud, Inc.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "courier": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.json && node --import ./test/setup-home.mjs --test test/*.test.mjs",
    "test:live": "tsc -p tsconfig.json && node scripts/happy-path.mjs"
  },
  "dependencies": {
    "@tinycloud/node-sdk": "3.9.0-beta.6",
    "@tinycloud/sdk-core": "3.9.0-beta.5",
    "@tinycloud/share-envelope": "1.4.1-beta.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TinyCloudLabs/js-sdk.git",
    "directory": "packages/courier"
  },
  "publishConfig": {
    "access": "public"
  }
}

      "name": "multi-space explicit SQL and KV read projection ignores writes secrets and defaults",
      "application": {
        "appId": "sample.app",
        "manifestHash": "fixture-hash",
        "manifests": [
          {
            "app_id": "sample.app",
            "name": "Sample",
            "defaults": false,
            "permissions": [
              {
                "service": "tinycloud.kv",
                "space": "guides",
                "path": "knowledge/",
                "actions": [
                  "get",
                  "list",
                  "put"
                ]
              },
              {
                "service": "tinycloud.sql",
                "space": "data",
                "path": "sample.sqlite",
                "actions": [
                  "read",
                  "write",
                  "schema"
                ],
                "skipPrefix": true

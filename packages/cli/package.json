{
  "name": "@tinycloud/cli",
  "version": "1.5.1-beta.2",
  "description": "TinyCloud CLI - manage data, delegations, and nodes from the terminal",
  "author": "TinyCloud, Inc.",
  "license": "EGPL",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tc": "./bin/tinycloud",
    "tinycloud": "./bin/tinycloud"
  },
  "files": [
    "dist",
    "bin",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "generate:reference": "bun scripts/generate-reference.ts",
    "check:generated": "bun scripts/generate-reference.ts --check",
    "check:coverage": "bun scripts/check-coverage.ts",
    "generate:node-release": "bun scripts/generate-node-release.ts",
    "check:node-release": "bun scripts/generate-node-release.ts --check",
    "smoke:delegated-secrets": "bun scripts/live-delegated-secrets-smoke.ts",
    "check:skill-pack": "node scripts/check-skill-pack.mjs",
    "sync:courier-skill": "rm -rf skills/courier && cp -R ../courier/skills/courier skills/courier"
  },
  "dependencies": {
    "@tinycloud/share-sdk": "1.4.2-beta.1",
    "@tinycloud/share-envelope": "1.4.1-beta.0",
    "@tinycloud/node-sdk": "3.8.1-beta.2",
    "@tinycloud/node-sdk-wasm": "1.7.8",
    "@tinycloud/sdk-core": "3.8.1-beta.2",
    "@tinycloud/sdk-services": "3.8.0",
    "@tinycloud/operations": "0.7.8-beta.2",
    "chalk": "^5.3.0",
    "commander": "^14.0.0",
    "jsdom": "26.1.0",
    "open": "^11.0.0",
    "ora": "^9.3.0",
    "siwe": "^3.0.0"
  },
  "devDependencies": {
    "@tinycloud/courier": "0.4.1-beta.2",
    "@tinycloud/replica": "0.4.0",
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  }
}

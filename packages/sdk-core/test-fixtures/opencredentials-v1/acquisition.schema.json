{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witness.credentials.org/schemas/credential-acquisition-request-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "profile", "profileVersion", "descriptorDigest", "requirementDigest", "holderDid", "inputs", "audience", "openerOrigin", "completionOrigin", "completionContext", "completionVerifierChallenge"],
  "properties": {
    "protocol": { "const": "tinycloud.credentials/acquisition/v1" },
    "profile": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?:/[a-z0-9][a-z0-9.-]*)?/v1$", "maxLength": 128 },
    "profileVersion": { "const": 1 },
    "descriptorDigest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "requirementDigest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "holderDid": { "type": "string", "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$", "maxLength": 128 },
    "inputs": { "type": "object", "minProperties": 1, "maxProperties": 32, "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 320 } },
    "audience": { "const": "tinycloud://credentials" },
    "openerOrigin": { "type": "string", "format": "uri", "pattern": "^https://" },
    "completionOrigin": { "type": "string", "format": "uri", "pattern": "^https://" },
    "completionContext": { "type": "string", "minLength": 1, "maxLength": 128 },
    "completionVerifierChallenge": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
  }
}

{
  "title": "TC-1777 manifest `keys` declaration vectors (shared: js-sdk sdk-core manifest validation, OpenKey R4)",
  "version": 1,
  "date": "2026-10-23",
  "agreed_by": ["SDK/CLI lead", "Artifacts lead (OpenKey)"],
  "rules": [
    "keys: array of 1..32 entries (an empty array is treated as absent: valid, declares nothing).",
    "entry: object with EXACTLY one of `path` | `prefix`, plus `abilities`; any other field is invalid (no `network`: always `default`).",
    "abilities: non-empty array of unique strings from {key.create, decrypt, key.block, key.unblock}; `key.delete` or any other string is invalid.",
    "path: an exact key path in the key grammar (segments `[a-z0-9][a-z0-9._-]{0,63}`, 3..8 segments, no empty/`.`/`..` segment, no leading or trailing `/`), segment 1 == `apps`, segment 2 == manifest `app_id` verbatim.",
    "prefix: exactly `apps/<app_id>/` (trailing `/` required; nothing deeper).",
    "app_id (snake_case field only) must itself match `^[a-z0-9][a-z0-9._-]{0,63}$` whole-string, else a manifest with a non-empty `keys` is invalid.",
    "duplicates: two entries with the same `path` are invalid; a second `prefix` entry is invalid; a `path` beside a `prefix` is valid.",
    "outcome: SDK = `invalid` throws ManifestValidationError (index-based message, never echoes the value); OpenKey = `invalid` ignores the whole `keys` block (no exemption, no grants from it)."
  ],
  "cases": [
    { "id": "K1", "app_id": "xyz.tinycloud.sample.healthlog", "keys": [ { "path": "apps/xyz.tinycloud.sample.healthlog/api-token", "abilities": ["key.create", "decrypt"] } ], "expect": "valid" },
    { "id": "K2", "app_id": "xyz.tinycloud.sample.healthlog", "keys": [ { "prefix": "apps/xyz.tinycloud.sample.healthlog/", "abilities": ["key.create", "decrypt"] } ], "expect": "valid" },
    { "id": "K3", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/a/b/c/d/e/f", "abilities": ["decrypt"] } ], "expect": "valid", "note": "8 segments" },
    { "id": "K4", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/a/b/c/d/e/f/g", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "9 segments" },
    { "id": "K5", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": ["key.create", "decrypt", "key.block", "key.unblock"] } ], "expect": "valid" },
    { "id": "K6", "app_id": "healthlog", "keys": [ { "prefix": "apps/healthlog/", "abilities": ["decrypt"] }, { "path": "apps/healthlog/x", "abilities": ["key.block"] } ], "expect": "valid", "note": "path beside prefix" },
    { "id": "K7", "app_id": "healthlog", "keys": [], "expect": "valid", "note": "empty = absent" },
    { "id": "K8", "app_id": "a_b-c.d", "keys": [ { "path": "apps/a_b-c.d/k", "abilities": ["decrypt"] } ], "expect": "valid", "note": "underscore, hyphen, dot in app_id" },

    { "id": "R1", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": ["key.delete"] } ], "expect": "invalid", "note": "key.delete never declarable" },
    { "id": "R2", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": ["block"] } ], "expect": "invalid", "note": "bare `block` is not an ability name" },
    { "id": "R3", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": ["tinycloud.encryption/decrypt"] } ], "expect": "invalid", "note": "full URN form not accepted; suffix only" },
    { "id": "R4", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": [] } ], "expect": "invalid", "note": "empty abilities" },
    { "id": "R5", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": ["decrypt", "decrypt"] } ], "expect": "invalid", "note": "duplicate ability" },
    { "id": "R6", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "prefix": "apps/healthlog/", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "both path and prefix" },
    { "id": "R7", "app_id": "healthlog", "keys": [ { "abilities": ["decrypt"] } ], "expect": "invalid", "note": "neither path nor prefix" },
    { "id": "R8", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": ["decrypt"], "network": "default" } ], "expect": "invalid", "note": "unknown field" },
    { "id": "R9", "app_id": "healthlog", "keys": [ { "path": "apps/other/x", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "another app's prefix" },
    { "id": "R10", "app_id": "healthlog", "keys": [ { "path": "secrets/x", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "outside apps/" },
    { "id": "R11", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "2 segments: the prefix itself is not a key" },
    { "id": "R12", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x/", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "trailing slash on a path" },
    { "id": "R13", "app_id": "healthlog", "keys": [ { "path": "apps/HealthLog/x", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "case differs from app_id; no folding" },
    { "id": "R14", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/X", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "uppercase segment" },
    { "id": "R15", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/../x", "abilities": ["decrypt"] } ], "expect": "invalid" },
    { "id": "R16", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog//x", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "empty segment" },
    { "id": "R17", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x%2Fy", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "percent-encoding" },
    { "id": "R18", "app_id": "healthlog", "keys": [ { "prefix": "apps/healthlog", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "prefix without trailing slash" },
    { "id": "R19", "app_id": "healthlog", "keys": [ { "prefix": "apps/healthlog/sub/", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "prefix deeper than the app's own" },
    { "id": "R20", "app_id": "healthlog", "keys": [ { "prefix": "apps/", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "all apps" },
    { "id": "R21", "app_id": "healthlog", "keys": [ { "prefix": "apps/healthlog/", "abilities": ["decrypt"] }, { "prefix": "apps/healthlog/", "abilities": ["key.create"] } ], "expect": "invalid", "note": "second prefix entry" },
    { "id": "R22", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": ["decrypt"] }, { "path": "apps/healthlog/x", "abilities": ["key.create"] } ], "expect": "invalid", "note": "duplicate path" },
    { "id": "R23", "app_id": "Xyz.App", "keys": [ { "path": "apps/xyz.app/x", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "app_id not a valid segment: cannot declare keys (no lowercasing)" },
    { "id": "R24", "app_id": "a234567890123456789012345678901234567890123456789012345678901234x", "keys": [ { "prefix": "apps/a234567890123456789012345678901234567890123456789012345678901234x/", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "app_id 65 chars" },
    { "id": "R25", "app_id": "healthlog", "keys": "apps/healthlog/x", "expect": "invalid", "note": "keys not an array" },
    { "id": "R26", "app_id": "healthlog", "keys": [ "apps/healthlog/x" ], "expect": "invalid", "note": "entry not an object" },
    { "id": "R27", "app_id": "healthlog", "keys_generated": { "count": 33, "path_template": "apps/healthlog/k{i}", "abilities": ["decrypt"] }, "expect": "invalid", "note": "33 entries; generate k0..k32" },
    { "id": "K9", "app_id": "healthlog", "keys_generated": { "count": 32, "path_template": "apps/healthlog/k{i}", "abilities": ["decrypt"] }, "expect": "valid", "note": "exactly 32 entries" },
    { "id": "R28", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x\u202e", "abilities": ["decrypt"] } ], "expect": "invalid", "note": "bidi control; message must not echo it" },
    { "id": "R29", "app_id": "healthlog", "keys": [ { "path": "apps/healthlog/x", "abilities": "decrypt" } ], "expect": "invalid", "note": "abilities not an array" }
  ],
  "sdk_only": [
    "S1: a manifest with a valid `keys` block passed to the CLI (`auth request --manifest`, `auth grant`, device/ticket flows) is REFUSED in v1 with a typed usage error and zero requests (CLI/agents get no apps/ grants in v1).",
    "S2: sign-in `ensureKey` runs only for entries declaring `key.create` (path entries: that key; prefix entries: none until the app names a key); a decrypt-only entry for a missing key gives KEY_NOT_FOUND."
  ]
}

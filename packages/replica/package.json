{
  "name": "@tinycloud/replica",
  "version": "0.4.0-beta.5",
  "description": "Durable, read-only local replicas of a TinyCloud KV prefix over the tinycloud.kv/sync change feed.",
  "author": "TinyCloud, Inc.",
  "license": "EGPL",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "require": "./dist/sqlite.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./profile-gate": {
      "types": "./dist/profile-gate.d.ts",
      "import": "./dist/profile-gate.js",
      "require": "./dist/profile-gate.cjs"
    },
    "./worker": {
      "types": "./dist/replica.worker.d.ts",
      "import": "./dist/replica.worker.js"
    },
    "./kv-storage": {
      "types": "./dist/kv-storage.d.ts",
      "import": "./dist/kv-storage.js"
    },
    "./kv-storage/worker": {
      "types": "./dist/kv-storage.worker.d.ts",
      "import": "./dist/kv-storage.worker.js"
    },
    "./kv-storage/testing": {
      "types": "./dist/kv-storage-testing.d.ts",
      "import": "./dist/kv-storage-testing.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run clean && tsup && bun scripts/hash-worker.ts",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "^1.8.0",
    "@tinycloud/sdk-services": "3.8.0-beta.18"
  },
  "devDependencies": {
    "@tinycloud/web-sdk-wasm": "1.7.7",
    "@types/node": "^20",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "viem": "^2.45.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TinyCloudLabs/js-sdk.git",
    "directory": "packages/replica"
  },
  "publishConfig": {
    "access": "public"
  }
}

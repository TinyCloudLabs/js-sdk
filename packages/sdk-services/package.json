{
  "name": "@tinycloud/sdk-services",
  "version": "3.8.0-beta.2",
  "description": "TinyCloud SDK Services - Platform-agnostic service implementations",
  "author": "TinyCloud, Inc.",
  "license": "EGPL",
  "sideEffects": [
    "dist/index.js",
    "dist/index.cjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./kv": {
      "types": "./dist/kv/index.d.ts",
      "import": "./dist/kv/index.js",
      "require": "./dist/kv/index.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./telemetry/requestLog": {
      "import": {
        "types": "./dist/telemetry/requestLog.d.ts",
        "default": "./dist/telemetry/requestLog.js"
      },
      "require": {
        "types": "./dist/telemetry/requestLog.d.cts",
        "default": "./dist/telemetry/requestLog.cjs"
      }
    },
    "./kv/replication/prefix": {
      "import": {
        "types": "./dist/kv/replication/prefix.d.ts",
        "default": "./dist/kv/replication/prefix.js"
      },
      "require": {
        "types": "./dist/kv/replication/prefix.d.cts",
        "default": "./dist/kv/replication/prefix.cjs"
      }
    },
    "./kv/replication/contractConstants": {
      "import": {
        "types": "./dist/kv/replication/contractConstants.d.ts",
        "default": "./dist/kv/replication/contractConstants.js"
      },
      "require": {
        "types": "./dist/kv/replication/contractConstants.d.cts",
        "default": "./dist/kv/replication/contractConstants.cjs"
      }
    },
    "./kv/replication/grantPolicyConstants": {
      "import": {
        "types": "./dist/kv/replication/grantPolicyConstants.d.ts",
        "default": "./dist/kv/replication/grantPolicyConstants.js"
      },
      "require": {
        "types": "./dist/kv/replication/grantPolicyConstants.d.cts",
        "default": "./dist/kv/replication/grantPolicyConstants.cjs"
      }
    },
    "./kv/replication/grantPolicyTypes": {
      "import": {
        "types": "./dist/kv/replication/grantPolicyTypes.d.ts",
        "default": "./dist/kv/replication/grantPolicyTypes.js"
      },
      "require": {
        "types": "./dist/kv/replication/grantPolicyTypes.d.cts",
        "default": "./dist/kv/replication/grantPolicyTypes.cjs"
      }
    },
    "./kv/replication/grantPolicy": {
      "import": {
        "types": "./dist/kv/replication/grantPolicy.d.ts",
        "default": "./dist/kv/replication/grantPolicy.js"
      },
      "require": {
        "types": "./dist/kv/replication/grantPolicy.d.cts",
        "default": "./dist/kv/replication/grantPolicy.cjs"
      }
    },
    "./kv/replication": {
      "import": {
        "types": "./dist/kv/replication/index.d.ts",
        "default": "./dist/kv/replication/index.js"
      },
      "require": {
        "types": "./dist/kv/replication/index.d.cts",
        "default": "./dist/kv/replication/index.cjs"
      }
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "import": "./dist/sql/index.js",
      "require": "./dist/sql/index.cjs"
    },
    "./encryption": {
      "types": "./dist/encryption/index.d.ts",
      "import": "./dist/encryption/index.js",
      "require": "./dist/encryption/index.cjs"
    },
    "./encryption/resource": {
      "import": {
        "types": "./dist/encryption/resource.d.ts",
        "default": "./dist/encryption/resource.js"
      },
      "require": {
        "types": "./dist/encryption/resource.d.cts",
        "default": "./dist/encryption/resource.cjs"
      }
    },
    "./encryption/named-keys": {
      "import": {
        "types": "./dist/encryption/named-keys.d.ts",
        "default": "./dist/encryption/named-keys.js"
      },
      "require": {
        "types": "./dist/encryption/named-keys.d.cts",
        "default": "./dist/encryption/named-keys.cjs"
      }
    },
    "./internal/decrypt-transport-response-error": {
      "types": "./dist/internal/decrypt-transport-response-error.d.cts",
      "import": "./dist/internal/decrypt-transport-response-error.cjs",
      "require": "./dist/internal/decrypt-transport-response-error.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "kv/replication": [
        "dist/kv/replication/index.d.ts"
      ],
      "kv/replication/prefix": [
        "dist/kv/replication/prefix.d.ts"
      ],
      "kv/replication/contractConstants": [
        "dist/kv/replication/contractConstants.d.ts"
      ],
      "kv/replication/grantPolicyConstants": [
        "dist/kv/replication/grantPolicyConstants.d.ts"
      ],
      "kv/replication/grantPolicyTypes": [
        "dist/kv/replication/grantPolicyTypes.d.ts"
      ],
      "kv/replication/grantPolicy": [
        "dist/kv/replication/grantPolicy.d.ts"
      ],
      "encryption/resource": [
        "dist/encryption/resource.d.ts"
      ],
      "encryption/named-keys": [
        "dist/encryption/named-keys.d.ts"
      ],
      "telemetry/requestLog": [
        "dist/telemetry/requestLog.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck:contract": "tsc --noEmit -p tsconfig.contract.json"
  },
  "dependencies": {
    "@tinycloud/bootstrap": "2.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@tinycloud/node-sdk-wasm": "1.7.8",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tinycloudlabs/web-sdk"
  }
}
